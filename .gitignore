# Python cache
__pycache__/
*.py[cod]

# Local environments
.venv/
venv/
env/

# Local secrets/config
.env
.env.*
!.env.example
.claude/settings.local.json

# Runtime logs/artifacts
*.log
build_output.txt
frontend_log.txt
claude_logs.md

# Project local data artifacts — ignore bulk/generic models only
backend/data/ml_models/
# Allow scalping & expert production models (needed for Render deployment)
!backend/data/ml_models/scalping_*.joblib
!backend/data/ml_models/expert_*.joblib
!backend/data/ml_models/expert_*_lstm.onnx
!backend/data/ml_models/expert_*_lstm.onnx.data
!backend/data/ml_models/expert_*_lstm_scaler.npz
!backend/data/ml_models/expert_*_lstm_meta.json
backend/data/*.db
backend/*.db
nul

# Include CSV uploads in repo (needed for Render ephemeral filesystem)
# Large legacy files excluded individually:
backend/data/uploads/DIA_5m_5Yea.csv
backend/data/uploads/EURUSD_5m_2Yea.csv
backend/data/uploads/SPY_5m_1Yea.csv

# Databento downloaded data (large CSVs, re-downloadable)
backend/data/databento/
backend/data/backtest_production/
