# ============================================================
# FlowrexAlgo — Environment Variables
# Copy this file to .env (local) or set in Render Dashboard
# ============================================================

# --- Debug Mode ---
# Set to true for local development (adds localhost CORS origins)
DEBUG=false

# --- Database ---
# Local: SQLite (default, no config needed)
# Render: PostgreSQL connection string
DATABASE_URL=sqlite:///./data/flowrexalgo.db
# DATABASE_URL=postgresql://user:password@host:5432/flowrexalgo

# --- Auth / Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Frontend URL (CORS — no trailing slash) ---
# Local: http://localhost:3000
# Render: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=./data/uploads

# --- News APIs ---
# Finnhub: https://finnhub.io (free tier available)
FINNHUB_API_KEY=your-finnhub-api-key

# Alpha Vantage: https://www.alphavantage.co (free tier available)
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key

# --- SMTP (Email Notifications, Invitations, 2FA) ---
# Gmail example: smtp.gmail.com / 587 / your-email@gmail.com / app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=notifications@yourdomain.com

# --- Telegram Bot (Notifications) ---
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- cTrader Open API (OAuth2 Broker Connection) ---
# Register your app at: https://openapi.ctrader.com/apps/
# Redirect URI must match: {FRONTEND_URL}/settings/broker/ctrader/callback
# e.g. https://flowrexalgo.onrender.com/settings/broker/ctrader/callback
CTRADER_CLIENT_ID=your-ctrader-client-id
CTRADER_CLIENT_SECRET=your-ctrader-client-secret

# --- Market Data: Databento (CME Futures) ---
# Sign up: https://databento.com  |  Pricing: ~$199/mo, $125 free credits on signup
# Supports: XAUUSD (GC), XAGUSD (SI), US30 (YM), NAS100 (NQ), BTC, EURUSD (6E)
# Leave empty to use Oanda/broker data (default)
DATABENTO_API_KEY=your-databento-api-key

# --- Auth Token Expiry (optional, defaults shown) ---
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Platform AI (LLM assistant for all users) ---
# Anthropic or OpenAI key used by the built-in AI assistant
PLATFORM_LLM_API_KEY=your-llm-api-key

# --- MT5 Remote Bridge (Windows VPS) ---
# MT5_BRIDGE_URL=https://your-vps-ip:8010
# MT5_BRIDGE_KEY=your-bridge-api-key
# MT5_BRIDGE_VERIFY_SSL=true
